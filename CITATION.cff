    given-names: "Gualberto"
version: "0.2.5"
date-released: "2026-11-11"
license: GPL-3.0-or-later
repository-code: "https://github.com/gualbe/orange_gualbe_ts"
url: "https://pypi.org/project/orange-gualbe-ts/"
keywords:
  - "Orange Data Mining"
  - "orange3 add-on"
  - "time series"
  - "forecasting"
  - "Orange3-Timeseries"
